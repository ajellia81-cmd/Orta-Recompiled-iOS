+            SDL_UnlockMutex(s_aj_mx);
+            if (st < 3)
+                s_aj_skipped++;
+            return st == 3 ? 1 : st == 4 ? 2 : 0;
+        }
+    }
+    j = aj_slot();
+    if (!j) {
