+    AJob *j;
+    int i;
+    SDL_LockMutex(s_aj_mx);
+    for (i = 0; i < AJ_MAX; i++) {
+        j = &s_aj[i];
+        if (j->state && j->kind == 1 && !memcmp(&j->key, k, PIPE_KEY_BYTES)) {
+            int st = j->state;
