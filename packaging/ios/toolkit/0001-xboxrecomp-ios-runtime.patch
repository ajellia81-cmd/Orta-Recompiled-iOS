+/* A pad's vibration made ready (iOS): one millisecond at the faintest level starts its haptics engine AND each
+ * motor's player - a zero level stops short of the players, which the title's first rumble then had to make, a
+ * long hitch at times (Lost World iOS port, 2026-11-19). Silent. */
+static void pad_rumble_warm(SDL_Gamepad *g)
+{
+#if defined(XI_IOS)
+    SDL_PropertiesID pr = g ? SDL_GetGamepadProperties(g) : 0;
+    if (pr && SDL_GetBooleanProperty(pr, SDL_PROP_GAMEPAD_CAP_RUMBLE_BOOLEAN, false))
+        SDL_RumbleGamepad(g, 1, 1, 1);
+    if (pr && SDL_GetBooleanProperty(pr, SDL_PROP_GAMEPAD_CAP_TRIGGER_RUMBLE_BOOLEAN, false))
+        SDL_RumbleGamepadTriggers(g, 1, 1, 1);
+#else
+    (void)g;
+#endif
+}
+
+#if defined(XI_IOS)
+/* iOS: the pads' haptics engines stop in the background and SDL never starts them again - after a return the
+ * pads did not vibrate any more. Back in front, every pad is opened afresh and its vibration readied at once (the
+ * hitch falls while the screen comes back, not at the first rumble); going away, the motors are stopped (the
+ * title's last setting is held for 10 s). The Lost World iOS port's handling (Gamepads::revive, 2026-11-19). */
+static SDL_AtomicInt s_pad_revive, s_pad_quiet;
+static bool SDLCALL pad_app_watch(void *u, SDL_Event *e)
+{
+    (void)u;
+    if (e->type == SDL_EVENT_DID_ENTER_FOREGROUND)
+        SDL_SetAtomicInt(&s_pad_revive, 1);
+    else if (e->type == SDL_EVENT_WILL_ENTER_BACKGROUND)
+        SDL_SetAtomicInt(&s_pad_quiet, 1);
+    return true;
+}
+
+static void pads_app_state(void)
+{
+    int p, n = 0;
+    if (SDL_GetAtomicInt(&s_pad_quiet) && SDL_SetAtomicInt(&s_pad_quiet, 0))
+        for (p = 0; p < XBOX_MAX_CONTROLLERS; p++)
+            if (g_pads[p]) {
+                SDL_RumbleGamepad(g_pads[p], 0, 0, 0);
+                SDL_RumbleGamepadTriggers(g_pads[p], 0, 0, 0);
+            }
+    if (!SDL_GetAtomicInt(&s_pad_revive) || !SDL_SetAtomicInt(&s_pad_revive, 0))
+        return;
+    {
+        Uint64 t0 = SDL_GetTicksNS();
+        int gone = 0;
+        for (p = 0; p < XBOX_MAX_CONTROLLERS; p++) {
+            if (!g_pads[p])
+                continue;
+            SDL_CloseGamepad(g_pads[p]);
+            g_pads[p] = SDL_OpenGamepad(g_pad_id[p]);
+            if (!g_pads[p]) {                 /* gone while away: as a disconnection */
+                g_pad_id[p] = 0;
+                gone = 1;
+                continue;
+            }
+            pad_rumble_warm(g_pads[p]);
+            n++;
+        }
+        if (n || gone)
+            fprintf(stderr, "  INPUT: back in front - %d pad(s) opened again, vibration ready (%.0f ms)\n", n,
+                    (SDL_GetTicksNS() - t0) / 1e6);
+        if (gone)
+            sort_pads();
+    }
+}
+#endif
